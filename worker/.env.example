# The worker reads the repository-root .env by default. This file lists only
# the variables the worker itself needs; see ../.env.example for the full set
# with commentary on which constants were verified and which were corrected.

SEPOLIA_RPC_URL=
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_PAY_SINK=
SEPOLIA_SHOP_ACK=

CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
CREDITCOIN_PROOF_BUILDER_TIMEOUT_MS=120000
CREDITCOIN_PROOF_BUILDER_TRANSPORT=curl
CREDITCOIN_CONSUME_GAS_LIMIT=8000000
CREDITCOIN_CHAIN_INFO=0x0000000000000000000000000000000000000fD3
CTC_PROOF_CONSUMER=

# Leave blank to resolve from the chain. Do not assume 1.
SOURCE_CHAIN_KEY=

# Gas only. This key has no authority over anyone's funds.
WORKER_PRIVATE_KEY=

WORKER_FROM_BLOCK=0
WORKER_SCAN_CHUNK_BLOCKS=500
WORKER_POLL_INTERVAL_MS=12000
ATTESTATION_TIMEOUT_MS=900000
WORKER_STATE_PATH=.relia-worker-state.json

# Read-only public progress feed. It never accepts proof submissions.
WORKER_STATUS_PORT=8787
WORKER_STATUS_ORIGIN=http://localhost:3000
