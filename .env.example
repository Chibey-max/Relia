# ---------------------------------------------------------------- Relia .env
# Copy to .env and fill in. Never commit .env. Never put a private key in any
# file that is tracked — the deploy scripts read the key from the environment
# and Foundry can also take --ledger / --account instead.

# --------------------------------------------------------------- Source chain
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111

# Deployed by contracts/script/DeploySepolia.s.sol
SEPOLIA_USDC=
SEPOLIA_PAY_SINK=
SEPOLIA_SHOP_ACK=

# 40 USDC at 6 decimals. Must match what AssetRegistry.list() was given.
INSTALLMENT_AMOUNT=40000000

# ----------------------------------------------------------- Execution chain
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031
CREDITCOIN_EXPLORER=https://creditcoin-testnet.blockscout.com

# CONFIRMED from the SDK: BLOCK_PROVER_PRECOMPILE_ADDRESS.
CREDITCOIN_BLOCK_PROVER=0x0000000000000000000000000000000000000FD2

# CONFIRMED from the SDK: CHAIN_INFO_PRECOMPILE_ADDRESS. Used to resolve
# SOURCE_CHAIN_KEY and to wait for attestation.
CREDITCOIN_CHAIN_INFO=0x0000000000000000000000000000000000000fD3

# UNVERIFIED — this address could not be checked from the build environment.
# Confirm with: cast code $CREDITCOIN_DECODER --rpc-url $CREDITCOIN_RPC_URL
CREDITCOIN_DECODER=0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f

# CORRECTED. The research table said proof-gen-api.cc3-testnet...; the SDK and
# its examples use this host. See docs/gate-2-constants.md.
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# Attestcoin's internal index for the source chain — NOT the EVM chain id.
# Leave blank: the worker resolves it from get_supported_chains() by matching
# chainId 11155111, and prints it. Set it only to pin a known-good value.
# Do NOT assume 1 — in the SDK's own examples chainKey 1 is Ethereum Mainnet.
SOURCE_CHAIN_KEY=

# Deployed by contracts/script/DeployCreditcoin.s.sol
CTC_ASSET_REGISTRY=
CTC_SHORTFALL_TAPE=
CTC_TITLE_PASS=
CTC_PROOF_CONSUMER=

# ------------------------------------------------------------------- Signing
# The worker's key. It only submits proofs — it never holds user funds and
# never has authority over anyone's money. Fund it with a little tCTC for gas.
WORKER_PRIVATE_KEY=

# Used by the deploy scripts only.
DEPLOYER_PRIVATE_KEY=

# ------------------------------------------------------------------- Worker
# Sepolia block to begin scanning from. 0 means "latest at startup".
WORKER_FROM_BLOCK=0
WORKER_POLL_INTERVAL_MS=12000
# The SDK's own default is 15 minutes.
ATTESTATION_TIMEOUT_MS=900000
